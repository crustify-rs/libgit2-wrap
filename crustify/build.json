{
  "version": 1,
  "build_commands": {
    "configure": "cmake -S . -B build-crustify -G Ninja -DCMAKE_BUILD_TYPE=Debug -DBUILD_SHARED_LIBS=ON -DBUILD_TESTS=ON -DBUILD_CLI=OFF -DBUILD_BENCHMARKS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_FUZZERS=OFF -DDEPRECATE_HARD=OFF -DUSE_SSH=OFF -DUSE_HTTP=ON -DUSE_HTTPS=OFF -DUSE_AUTH_NTLM=OFF -DUSE_AUTH_NEGOTIATE=OFF -DUSE_SHA1=builtin -DUSE_SHA256=builtin -DUSE_HTTP_PARSER=builtin -DUSE_REGEX=builtin -DUSE_COMPRESSION=builtin -DCMAKE_C_FLAGS='-fsanitize=address,undefined -fno-omit-frame-pointer' -DCMAKE_SHARED_LINKER_FLAGS='-fsanitize=address,undefined' -DCMAKE_EXE_LINKER_FLAGS='-fsanitize=address,undefined'",
    "build": "cmake --build build-crustify --parallel 112",
    "test": "ASAN_OPTIONS=detect_leaks=0 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir build-crustify --output-on-failure -R '^(gitdaemon_namespace|ssh|online_customcert)$' -j1"
  }
}
